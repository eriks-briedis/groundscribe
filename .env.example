# Copy to .env and change the password. .env is git-ignored; this file is not.
#
# The password is the only credential groundscribe has: whoever knows it can
# drive the whole pipeline. The session cookie is signed with a key derived from
# it, so changing it here signs every browser out.
GROUNDSCRIBE_PASSWORD=change me before serving this anywhere

# The model provider. Set one of the two below, or neither: without one, no
# provider is registered and any stage that needs a model fails saying which one
# it wanted — nothing is silently sent anywhere, and nothing silently succeeds
# without a model either.
#
# Setting one makes that provider *reachable*. It does not make it permitted:
# each project still has to name the provider in its allowed providers before any
# of its material is sent (`writer project create --provider ollama`). That is
# true of the local provider too — being local is not consent.

# ---------------------------------------------------------------------------
# Local models, via Ollama. What the shipped routing config expects.
# ---------------------------------------------------------------------------
#
# No key, no account, nothing leaves the machine. Set the address of the server
# and pull the model the routing config names:
#
#   ollama pull qwen3.6:35b
#
# The address is required even though localhost is the obvious default, and that
# is deliberate: plenty of machines run Ollama for something else, and one that
# happens to be listening has not thereby volunteered it to this application.
#
# Point it wherever the server actually is — another box on the LAN works, and
# from inside the compose stack the host is reachable as `host.docker.internal`.
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# OpenAI. Requires editing config/model-routing.yaml, which ships pointed local.
# ---------------------------------------------------------------------------
#
# This is an **API key** from platform.openai.com, billed per token. A ChatGPT
# subscription is a different product and does not carry one.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # an Azure or gateway endpoint

# Where the local database and artefact bytes live. Both optional.
# GROUNDSCRIBE_DATABASE_URL=sqlite+pysqlite:///groundscribe.db
# GROUNDSCRIBE_BLOB_ROOT=var/blobs
