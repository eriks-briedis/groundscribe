# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Databases / local artefacts
#
# The write-ahead log and shared-memory index are as much "the database" as the
# file they are named after: SQLite writes there first and checkpoints later, so
# a tracked `-wal` is live state that git will happily rewrite under a running
# process. It did, once, and the next read came back "malformed database schema".
# `*.db` alone does not cover them, because the sidecars are `*.db-wal`, not
# `*.wal`.
*.db
*.db-*
*.sqlite
*.sqlite*-shm
*.sqlite*-wal

# The content-addressed blob store: this project's *material*, not its code.
# Two blobs were committed by accident, which is two more copies of somebody's
# source document than a repository should hold.
var/

# Environment
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store

# Node / frontend (placeholder for later phases)
node_modules/
frontend/dist/
